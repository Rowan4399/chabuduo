+                trajectory[:, 1],
+                transform=PlateCarree(),
+                color=color,
+                alpha=0.30,
+                linewidth=0.7,
+            )
+        axis.scatter(
+            [anchor[0]], [anchor[1]], transform=PlateCarree(),
+            marker="x", color="black", s=38, zorder=5,
+        )
+        axis.set_extent(
+            [bounds[0][0], bounds[1][0], bounds[0][1], bounds[1][1]], PlateCarree()
+        )
+        axis.set(
+            xlabel="Longitude (°)",
+            ylabel="Latitude (°)",
+            title=f"t = {timestep}  |  n = {xy.shape[1]}",
