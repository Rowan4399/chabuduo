+    axes.flat[-1].axis("off")
+    axes.flat[-1].text(
+        0.03,
+        0.95,
+        note,
+        va="top",
+        fontsize=12,
+        linespacing=1.6,
+        transform=axes.flat[-1].transAxes,
+    )
+    figure.suptitle(title, fontsize=17)
+    figure.savefig(output, dpi=180)
+    plt.close(figure)
+
