+def map_lonlat(xy):
+    """Invert cached kilometres relative to LSZH RWY 14 using its source CRS."""
+    airport = airports["LSZH"]
+    threshold = next(p for p in airport.runways["14"].tuple_runway if p.name == "14")
+    projection = airport_projection("LSZH")
+    anchor = np.array(projection(threshold.longitude, threshold.latitude))
+    absolute_xy = xy.reshape(-1, 2) * 1000 + anchor
+    t = Traffic(pd.DataFrame(absolute_xy, columns=["x", "y"]))
+    t = t.compute_latlon_from_xy(projection=projection)
+    return t.data[["longitude", "latitude"]].to_numpy().reshape(xy.shape)
+
+
+def map_bounds(*arrays):
+    lonlat = map_lonlat(np.concatenate([array.reshape(-1, 2) for array in arrays]))
+    low, high = lonlat.min(axis=0), lonlat.max(axis=0)
+    margin = np.maximum(0.04, 0.05 * (high - low))
+    return low - margin, high + margin
+
