+        "turn_total_s",
+        "turn_longest_s",
+        "direction_jump_deg",
+        "short_turn_degps",
+    ],
+}
+LOWER = {"aligned_length_m", "path_length_m", "duration_s", "entry_radius_m"}
+GATES = ["path_length_m", "duration_s", "entry_radius_m"]
